# Server Configuration
PORT=5000

# Database Configuration
# Options: 'mysql' or 'sqlite'
# Defaults to 'sqlite' for out-of-the-box zero-setup execution if MySQL is not running
DB_TYPE=sqlite

# MySQL Connection Details (Used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=research_portal

# Student Submission Metadata
STUDENT_ROLL_NO=P24-0000
STUDENT_NAME=Student Name
STUDENT_CLASS=BS-CS-5B
GITHUB_REPO_URL=https://github.com/username/research-opportunity-portal
