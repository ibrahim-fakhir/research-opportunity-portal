          "raw": "{\n  \"title\": \"Deep Learning for Medical Image Segmentation\",\n  \"description\": \"Investigating transformer-based vision architectures for MRI scan segmentation with clinical validation.\",\n  \"research_area\": \"Artificial Intelligence & Computer Vision\",\n  \"faculty_name\": \"Dr. Tariq Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, PyTorch, OpenCV, MONAI, Git\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-11-30\",\n  \"status\": \"Open\"\n}"
